# ═══════════════════════════════════════════════════════════
# Coast Run — secrets template (safe to commit)
# Copy to .env and fill values. Never commit .env.
# ═══════════════════════════════════════════════════════════

# ── Pexels API — https://www.pexels.com/api/ ───────────────
PEXELS_API_KEY=
PEXELS_API_BASE_URL=https://api.pexels.com/v1
PEXELS_VIDEOS_BASE_URL=https://api.pexels.com/videos

# ── Kling AI API — https://app.klingai.com/global/dev ──────
# Official (Kuaishou): fill ACCESS + SECRET (JWT auth)
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# Third-party reseller only: fill this instead of AK/SK
KLING_API_KEY=

# Official default. Alt: https://api-singapore.klingai.com
KLING_BASE_URL=https://api.klingai.com
