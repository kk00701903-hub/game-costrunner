  m_Script: {fileID: 11500000, guid: 729b4d9000158ed46b625ca80e255674, type: 3}
  m_Name: StoryConfig
  m_EditorClassIdentifier: Assembly-CSharp::CoastRun.StoryConfig
  playPrologue: 1
  prologueVideo: {fileID: 0}
  prologueBeats:
  - title: "\uC57D\uC18D\uC758 \uC2A4\uB9C8\uD2B8\uD3F0"
    body: "\u300C\uB178\uC744 \uC9C8 \uB54C, \uC6B0\uB9AC \uC5B4\uB9B4 \uC801 \uBE44\uBC00
      \uAE30\uC9C0\uC600\uB358 \uADF8 \uC1A1\uC804\uD0D1 \uC544\uB798\uC5D0\uC11C
      \uB9CC\uB098\uC790.\n\uAF2D \uD560 \uB9D0\uC774 \uC788\uC5B4.\u300D\n\n\uBA40\uB9AC
      \uC544\uC2A4\uB77C\uD788 \uBCF4\uC774\uB294 \uC1A1\uC804\uD0D1 \uC0AC\uC9C4\uC774
      \uD568\uAED8 \uC640 \uC788\uB2E4."
    holdSeconds: 5.5
  - title: "\uC608\uAE30\uCE58 \uBABB\uD55C \uC7A5\uC560"
    body: "\uC815\uB958\uC7A5 \uC804\uAD11\uD310 \u2014 \u300E\uC815\uBE44 \uC911
      \xB7 \uC6B4\uD589 \uC911\uB2E8\u300F.\n\uD0DD\uC2DC\uB97C \uC7A1\uC73C\uB824
      \uD574\uB3C4 \uCD95\uC81C\uB85C \uB3C4\uB85C\uAC00 \uB9C9\uD614\uACE0,\n\uC9C0\uB098\uAC00\uB294
      \uCC28\uB4E4\uC740 \uBAA8\uB450 \uC608\uC57D\uB4F1\uB9CC \uCF20 \uCC44 \uC2A4\uCCD0
      \uAC04\uB2E4."
    holdSeconds: 5
  - title: "\uC18C\uB140\uC758 \uACB0\uC2EC"
    body: "\uD574\uAC00 \uAE30\uC6B8\uAE30 \uC2DC\uC791\uD55C\uB2E4.\n\uBC30\uB0AD\uC5D0
      \uBB36\uC778 \uBCF4\uB4DC\uB97C \uD480\uACE0, \uB545\uC5D0 \uB0B4\uB824\uB193\uB294\uB2E4.\n\uC218\uD3C9\uC120
      \uB108\uBA38 \uC1A1\uC804\uD0D1\uC744 \uBC14\uB77C\uBCF4\uBA70 \u2014 \uD798\uCC28\uAC8C
      \uB545\uC744 \uAC77\uC5B4\uCC2C\uB2E4."
    holdSeconds: 4.5
  landmarks:
  - trigger: 0.04
    useAbsoluteMetres: 0
    title: "\uCD9C\uBC1C \xB7 \uC815\uB958\uC7A5"
    monologue: "\uBC84\uC2A4\uAC00 \uC548 \uC624\uBA74, \uBCF4\uB4DC\uAC00 \uB2F5\uC774\uC9C0."
  - trigger: 0.08
    useAbsoluteMetres: 0
    title: "\uBD04 \xB7 \uBC9A\uAF43 \uAC00\uB85C\uC218"
    monologue: "\uBD84\uD64D \uBE44 \uAC19\uB358 \uADF8 \uBD04\u2026 \uAC19\uC774
      \uB6F0\uC5C8\uC9C0."
  - trigger: 0.12
    useAbsoluteMetres: 0
    title: "\uCD94\uC5B5 \xB7 \uBC29\uD30C\uC81C"
    monologue: "\uC544\uC774\uC2A4\uD06C\uB9BC \uB179\uC774\uB358 \uBC29\uD30C\uC81C.
      \uBC14\uB78C\uC774 \uAC19\uC544."
  - trigger: 0.16
    useAbsoluteMetres: 0
    title: "\uCE74\uD398 \uACE8\uBAA9"
    monologue: "\uCC3D\uAC00 \uC790\uB9AC\u2026 \uB124\uAC00 \uBA3C\uC800 \uACE0\uB974\uB358
      \uACF3."
  - trigger: 0.2
    useAbsoluteMetres: 0
    title: "\uC804\uC2E0\uC8FC \uACE8\uBAA9"
    monologue: "\u300E\uBE44\uBC00 \uAE30\uC9C0\uAE4C\uC9C0 \uB204\uAC00 \uBA3C\uC800\u300F
      \uB0B4\uAE30."
  - trigger: 0.25
    useAbsoluteMetres: 0
    title: "\uC5EC\uB984 \xB7 \uD574\uC218\uC695\uC7A5"
    monologue: "\uD30C\uB3C4 \uC18C\uB9AC\uC5D0 \uB9D0\uC744 \uC0BC\uD0A4\uB358 \uC5EC\uB984."
  - trigger: 0.3
    useAbsoluteMetres: 0
    title: "\uC11C\uD504\uC20D \uC55E"
    monologue: "\uBE4C\uB824 \uD0C4 \uBCF4\uB4DC, \uBB34\uB98E \uAE4C\uC9D0, \uC6C3\uC74C."
  - trigger: 0.35
    useAbsoluteMetres: 0
    title: "\uCD95\uC81C \uD589\uB82C"
    monologue: "\uC624\uB298\uB3C4 \uAE38\uC774 \uB9C9\uD614\uC5B4. \uADF8\uB54C\uB3C4."
  - trigger: 0.4
    useAbsoluteMetres: 0
    title: "\uC790\uD310\uAE30 \uCF54\uB108"
    monologue: "\uB530\uB73B\uD55C \uCE94\uCEE4\uD53C \uB098\uB220 \uB9C8\uC2DC\uB358
      \uBC24."
  - trigger: 0.45
    useAbsoluteMetres: 0
    title: "\uAC00\uC744 \xB7 \uB099\uC5FD"
    monologue: "\uB099\uC5FD \uBC1F\uB294 \uC18C\uB9AC\u2026 \uB124\uAC00 \uC88B\uC544\uD588\uC9C0."
  - trigger: 0.5
    useAbsoluteMetres: 0
    title: "\uC5B8\uB355 \uC804\uB9DD"
    monologue: "\uC5EC\uAE30\uC11C \uC1A1\uC804\uD0D1\uC774 \uCC98\uC74C\uC73C\uB85C
      \uBCF4\uC5EC."
  - trigger: 0.55
    useAbsoluteMetres: 0
    title: "\uBE44 \uC624\uB358 \uB0A0"
    monologue: "\uC6B0\uC0B0 \uD558\uB098. \uC5B4\uAE68\uAC00 \uC816\uC5C8\uC5B4."
  - trigger: 0.6
    useAbsoluteMetres: 0
    title: "\uB4F1\uB300 \uC544\uB798"
    monologue: "\uB4F1\uB300 \uBD88\uBE5B\uC5D0 \uC57D\uC18D\uD588\uC9C0. \uAF2D
      \uB3CC\uC544\uC624\uC790\uACE0."
  - trigger: 0.65
    useAbsoluteMetres: 0
    title: "\uACA8\uC6B8 \xB7 \uCCAB\uB208"
    monologue: "\uCCAB\uB208\uC5D0 \uC190 \uC7A1\uB358 \uB0A0. \uC190\uAC00\uB77D\uC774
      \uC2DC\uB838\uC5B4."
  - trigger: 0.7
    useAbsoluteMetres: 0
    title: "\uB208 \uC313\uC778 \uC0B0\uCC45\uB85C"
    monologue: "\uBCF4\uB4DC \uBC14\uD034\uAC00 \uD558\uC598\uC9C0\uB358 \uACA8\uC6B8."
  - trigger: 0.75
    useAbsoluteMetres: 0
    title: "\uCCA0\uAE38 \uAC74\uB108"
    monologue: "\uAE30\uC801 \uC18C\uB9AC\uC5D0 \uB9D0\uC744 \uBA48\uCDC4\uB358 \uACF3."
  - trigger: 0.8
    useAbsoluteMetres: 0
    title: "\uB178\uC744 \uC9C1\uC804"
    monologue: "\uD558\uB298\uC774 \uC8FC\uD669\uC73C\uB85C \uBB3C\uB4E4\uAE30 \uC2DC\uC791\uD574."
  - trigger: 0.85
    useAbsoluteMetres: 0
    title: "\uBE14\uB8E8\uC544\uC6CC"
    monologue: "\uBCF4\uB78F\uBE5B\u2026 \uAC70\uC758 \uB2E4 \uC654\uC5B4."
  - trigger: 0.9
    useAbsoluteMetres: 0
    title: "\uC1A1\uC804\uD0D1 \uC2E4\uB8E8\uC5E3"
    monologue: "\uC800\uAE30\uB2E4. \uC5B4\uB9B4 \uC801 \uBE44\uBC00 \uAE30\uC9C0."
  - trigger: 0.95
    useAbsoluteMetres: 0
    title: "\uB9C8\uC9C0\uB9C9 \uAD7D\uC774"
    monologue: "\uC870\uAE08\uB9CC \uB354\u2026 \uAE30\uB2E4\uB824\uC918."
  nearMissCheerLines:
  - "\uC870\uAE08\uB9CC \uB354 \uAE30\uB2E4\uB824\uC918!"
  - "\uC544\uC9C1\uC774\uC57C\u2026 \uB2A6\uC9C0 \uC54A\uC744 \uAC70\uC57C."
  - "\uC1A1\uC804\uD0D1\uAE4C\uC9C0, \uD55C \uBC88\uC5D0!"
  - "\uB178\uC744 \uC804\uC5D0 \uAF2D \uAC08\uAC8C."
  - "\uAE30\uB2E4\uB824\u2026 \uAE08\uBC29\uC774\uC57C!"
  - "\uBE44 \uC640\uB3C4 \uAD1C\uCC2E\uC544."
  - "\uB208\uC774\uB77C\uB3C4\u2026 \uAC08\uAC8C."
  - "\uBD04\xB7\uC5EC\uB984\xB7\uAC00\uC744\xB7\uACA8\uC6B8, \uB2E4 \uB2EC\uB824\uC11C!"
  - "\uBC14\uD034\uC57C, \uC870\uAE08\uB9CC \uB354!"
  - "\uADF8 \uC0AC\uB78C\u2026 \uC544\uC9C1 \uC788\uC9C0?"
